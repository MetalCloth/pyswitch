PYSWITCH_ROUTING_STRATEGY=round_robin
PYSWITCH_STORAGE_BACKEND=memory
PYSWITCH_COORDINATION_BACKEND=memory
PYSWITCH_EVENT_BACKEND=memory
PYSWITCH_DATABASE_URL=postgresql+asyncpg://pyswitch:pyswitch@localhost:5432/pyswitch
PYSWITCH_REDIS_URL=redis://localhost:6379/0
PYSWITCH_KAFKA_BOOTSTRAP_SERVERS=localhost:19092
PYSWITCH_KAFKA_TOPIC=pyswitch.events
PYSWITCH_SUPPORTED_CURRENCIES=INR,USD,EUR
PYSWITCH_REQUEST_TIMEOUT_SECONDS=5
PYSWITCH_ADMIN_TOKEN=local-dev-only
PYSWITCH_RATE_LIMIT_CAPACITY=60
PYSWITCH_RATE_LIMIT_REFILL_PER_SECOND=1
