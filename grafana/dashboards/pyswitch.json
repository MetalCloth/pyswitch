  "panels": [
    {
      "id": 1,
      "title": "Payments by status",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (status) (rate(pyswitch_payments_total[5m]))", "legendFormat": "{{status}}"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "title": "Provider latency",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (provider, le) (rate(pyswitch_provider_latency_seconds_bucket[5m])))", "legendFormat": "{{provider}} p95"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "id": 3,
      "title": "Provider circuit state",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "pyswitch_provider_circuit_state", "legendFormat": "{{provider}} {{state}}"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
    },
    {
      "id": 4,
      "title": "Rate-limit rejections",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "rate(pyswitch_rate_limit_rejections_total[5m])", "legendFormat": "rejections/s"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
    }
  ],
